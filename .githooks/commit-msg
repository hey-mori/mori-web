#!/usr/bin/env bash
#
# Reject a commit whose message breaks the Mori commit format before the commit
# exists. The rule lives in scripts/validate-commit-message.sh. Installed by
# scripts/setup-git-hooks.sh.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
if ! bash "$repo_root/scripts/validate-commit-message.sh" "$1"; then
  echo "" >&2
  echo "commit rejected: see https://github.com/hey-mori/.github/blob/main/docs/commit-format.md" >&2
  exit 1
fi
