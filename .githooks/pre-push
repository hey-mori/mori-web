#!/usr/bin/env bash
#
# Refuse a push straight to main. Every change to main arrives through a pull
# request. Installed by scripts/setup-git-hooks.sh.
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "push rejected: main changes through a pull request" >&2
    exit 1
  fi
done
exit 0
