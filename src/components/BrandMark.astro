---
/** The brand mark: a soft four-point star on a rounded gradient tile.
    The single place gradient is allowed (brand identity reference §3). */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="brand-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--brand-gradient-start)"></stop>
      <stop offset="1" stop-color="var(--brand-gradient-end)"></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="14" fill="url(#brand-g)"></rect>
  <path
    d="M32 14c1.9 10.6 5.5 14.2 16 16-10.5 1.8-14.1 5.4-16 16-1.9-10.6-5.5-14.2-16-16 10.5-1.8 14.1-5.4 16-16z"
    fill="#ffffff"></path>
</svg>
