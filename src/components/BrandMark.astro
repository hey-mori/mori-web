---
/** The brand mark: the guiding star over a soft focus beam on a gradient tile.
    Geometry and colours mirror the app's MoriLogo component
    (src/components/brand/MoriLogo.tsx in hey-mori/mori); change the app first,
    then copy here. The single place a gradient is allowed. */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="brand-tile" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5C52F4"></stop>
      <stop offset="0.55" stop-color="#715DEB"></stop>
      <stop offset="1" stop-color="#AA86F5"></stop>
    </linearGradient>
    <linearGradient id="brand-beam" x1="0" y1="0.45" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.18"></stop>
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0.38"></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="9.5" fill="url(#brand-tile)"></rect>
  <path d="M17.1 64 L25.9 38.1 C27.5 40.4 29.5 41.7 32 42.8 C34.5 41.7 36.5 40.4 38.1 38.1 L46.9 64 Z" fill="url(#brand-beam)"></path>
  <path d="M32 14.125 C34.5 14.125 35.375 16.4375 36.5 21.0625 C37.875 26.75 39.875 28.875 45.125 30.3125 C49.1875 31.375 50.375 32.3125 50.375 33.5 C50.375 35.0625 48.4375 35.75 44.625 36.75 C39.375 38.125 37.5625 40.1875 36.1875 45.875 C35.0625 50.5 34.5 52.25 32 52.25 C29.5 52.25 28.9375 50.5 27.8125 45.875 C26.4375 40.1875 24.625 38.125 19.375 36.75 C15.5625 35.75 13.625 35.0625 13.625 33.5 C13.625 32.3125 14.8125 31.375 18.875 30.3125 C24.125 28.875 26.125 26.75 27.5 21.0625 C28.625 16.4375 29.5 14.125 32 14.125 Z" fill="#FFFFFF"></path>
</svg>
