---
import { SITE } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-row">
    <p class="footer-line">
      © {year} {SITE.org} · 로컬-first로 만듭니다. 데이터는 기본으로 사용자의 기기에 머무릅니다.
    </p>
    <p class="footer-note">
      <a href={SITE.repositoryUrl}>GitHub</a> · MPL-2.0
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: var(--space-8) 0;
    margin-top: var(--space-24);
  }

  .footer-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-line {
    font-size: 13px;
    color: var(--muted);
  }

  .footer-note {
    font-size: 12px;
    color: var(--muted-2);
  }
</style>
