---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지가 없습니다">
  <section class="section">
    <div class="container narrow">
      <h1 class="section-title">페이지를 찾을 수 없습니다</h1>
      <p class="lead-note">주소가 바뀌었거나 없는 페이지입니다.</p>
      <a class="home-link" href="/">처음으로</a>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 720px;
  }

  .lead-note {
    font-size: 15px;
    color: var(--muted);
    margin-bottom: var(--space-6);
  }

  .home-link {
    font-weight: 600;
  }
</style>
