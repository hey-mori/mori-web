---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CHANGELOG } from "../data/changelog";
---

<BaseLayout title="변경 이력" description="제품 진행 상황 기록">
  <section class="section">
    <div class="container">
      <h1 class="section-title">변경 이력</h1>
      <div class="entries">
        {
          CHANGELOG.map((entry) => (
            <article class="card entry">
              <header class="entry-head">
                <h2 class="entry-title">{entry.title}</h2>
                <time class="entry-date" datetime={entry.date}>
                  {entry.date}
                </time>
              </header>
              <ul class="entry-items">
                {entry.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .entries {
    display: grid;
    gap: var(--space-4);
    max-width: 720px;
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .entry-title {
    font-size: 16px;
    font-weight: 650;
  }

  .entry-date {
    font-size: 13px;
    color: var(--muted-2);
    font-variant-numeric: tabular-nums;
  }

  .entry-items {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: var(--space-1);
  }

  .entry-items li {
    font-size: 14px;
    color: var(--muted);
  }
</style>
