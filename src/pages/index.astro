---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FAMILY, SITE } from "../config/site";

const pillars = [
  {
    title: "로컬-first",
    body: "클라우드 동기화도, 계정도 없습니다. 기록과 그 원본은 사용자의 기기에 저장됩니다.",
  },
  {
    title: "숨은 수집 없음",
    body: "화면 녹화나 키 입력 수집은 하지 않습니다. 사용자가 직접 연결한 출처만 읽습니다.",
  },
  {
    title: "되돌릴 수 있는 정리",
    body: "자동으로 정리한 내용은 표시되고 언제든 되돌릴 수 있습니다. 원본은 그대로 남습니다.",
  },
];

const loop = [
  {
    step: "남기기",
    body: "메모, 링크, 붙여 넣은 대화, Git 기록, AI 에이전트 세션을 최소한의 손으로 남깁니다.",
  },
  {
    step: "정리",
    body: "흔적을 기록으로 구조화하고, 일어난 시간과 속한 프로젝트에 연결합니다.",
  },
  {
    step: "확인",
    body: "확신이 낮거나 되돌리기 어려운 변경은 적용하기 전에 사용자에게 묻습니다.",
  },
  {
    step: "다시 쓰기",
    body: "그날 한 일, 프로젝트의 흐름, 다음 작업에 넘길 맥락으로 기록을 다시 꺼내 씁니다.",
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <span class="badge">
        <span class="badge-dot" aria-hidden="true"></span>
        오픈 소스 · MPL-2.0
      </span>
      <h1 class="hero-title">{SITE.tagline}</h1>
      <p class="hero-desc">{SITE.description}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={SITE.repositoryUrl}>GitHub에서 보기</a>
        <a class="button button-quiet" href="/changelog">변경 이력</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">흔적은 흩어지고, 맥락은 남지 않습니다</h2>
      <p class="lead">
        AI 대화, Git 기록, 메모, 읽은 글. 작업의 흔적은 여러 도구에 흩어져 있고, 며칠이 지나면
        그때 무엇을 했는지, 왜 그렇게 결정했는지 답하기 어렵습니다. {SITE.productName}는 그
        흔적을 시간과 프로젝트에 연결된 기록으로 정리해, 필요할 때 다시 꺼내 쓸 수 있게 합니다.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">원칙</h2>
      <div class="grid-3">
        {
          pillars.map((p) => (
            <div class="card">
              <h3 class="card-title">{p.title}</h3>
              <p class="card-body">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">하나의 흐름</h2>
      <ol class="loop">
        {
          loop.map((l, i) => (
            <li class="loop-item">
              <span class="loop-index">{i + 1}</span>
              <div>
                <h3 class="loop-step">{l.step}</h3>
                <p class="card-body">{l.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2 class="section-title">함께 쓰는 도구</h2>
      <div class="grid-2">
        {
          FAMILY.map((p) => (
            <a class="card family-card" href={p.href}>
              <h3 class="card-title">{p.name}</h3>
              <p class="card-body">{p.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-24) 0 var(--space-16);
    border-bottom: 1px solid var(--line);
    background: var(--panel-soft);
  }

  .hero-title {
    font-size: 44px;
    font-weight: 700;
    margin-top: var(--space-6);
    max-width: 640px;
  }

  .hero-desc {
    margin-top: var(--space-6);
    font-size: 18px;
    color: var(--muted);
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .button:hover,
  .family-card:hover {
    text-decoration: none;
  }

  .button-primary {
    background: var(--purple);
    color: #fff;
  }

  .button-primary:hover {
    color: #fff;
    background: #5136e0;
  }

  .button-quiet {
    border: 1px solid var(--line-strong);
    background: var(--panel);
    color: var(--text);
  }

  .button-quiet:hover {
    color: var(--text);
    border-color: var(--muted-2);
  }

  .family-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .family-card:hover {
    color: inherit;
    border-color: var(--line-strong);
  }

  .family-card .card-title::after {
    content: " →";
    color: var(--purple);
  }

  .lead {
    font-size: 17px;
    color: var(--muted);
    max-width: 720px;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .card-title {
    font-size: 16px;
    font-weight: 650;
    margin-bottom: var(--space-2);
  }

  .card-body {
    font-size: 14px;
    color: var(--muted);
  }

  .loop {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .loop-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .loop-index {
    flex: none;
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--purple-50);
    color: var(--purple);
    font-size: 13px;
    font-weight: 650;
  }

  .loop-step {
    font-size: 15px;
    font-weight: 650;
    margin-bottom: var(--space-1);
  }

  @media (max-width: 720px) {
    .hero-title {
      font-size: 32px;
    }

    .grid-3,
    .grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
