---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";

const pillars = [
  {
    title: "로컬-first",
    body: "클라우드 동기화도, 계정도 없습니다. 세션 기록과 기억은 전부 사용자의 기기에만 저장됩니다.",
  },
  {
    title: "명시적 캡처",
    body: "숨어서 지켜보지 않습니다. 사용자가 명시적으로 연결한 에이전트 기록만, 보이는 상태로 읽습니다.",
  },
  {
    title: "리뷰 게이트",
    body: "AI는 제안만 합니다. 어떤 해석도 사용자의 검토와 승인 없이는 오래가는 기억이 되지 않습니다.",
  },
];

const loop = [
  {
    step: "캡처",
    body: "Claude Code를 비롯한 AI 에이전트의 작업 세션을 실시간으로 따라가거나 명시적으로 가져옵니다.",
  },
  {
    step: "검토",
    body: "요청 단위로 정리된 타임라인에서 무슨 일이 있었는지, 근거는 무엇인지 확인합니다.",
  },
  {
    step: "기억",
    body: "결정, 미해결 이슈, 다음 할 일이 증거 링크와 함께 프로젝트 기억으로 쌓입니다.",
  },
  {
    step: "핸드오프",
    body: "다음 세션, 다른 에이전트, 동료에게 넘길 수 있는 검토된 이어가기 산출물을 한 번에 만듭니다.",
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <span class="badge">
        <span class="badge-dot" aria-hidden="true"></span>
        프라이빗 개발 중
      </span>
      <h1 class="hero-title">{SITE.tagline}</h1>
      <p class="hero-desc">{SITE.description}</p>
      <p class="hero-status">
        데스크톱 앱(macOS)은 준비 중입니다. 진행 상황은 <a href="/changelog">변경 이력</a>에서 볼
        수 있습니다.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">일은 흘러가고, 기억은 남지 않습니다</h2>
      <p class="lead">
        AI 에이전트와 일하는 하루는 수십 개의 요청과 수백 개의 도구 실행으로 이루어집니다. 대화는
        스크롤 너머로 사라지고, 왜 그런 결정을 했는지는 다음 세션이 되면 아무도 답할 수
        없습니다. {SITE.productName}는 그 흐름을 증거가 연결된 기록으로 바꾸고, 검토를 거친 것만
        오래가는 기억으로 남깁니다.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">원칙</h2>
      <div class="grid-3">
        {
          pillars.map((p) => (
            <div class="card">
              <h3 class="card-title">{p.title}</h3>
              <p class="card-body">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">하나의 루프</h2>
      <ol class="loop">
        {
          loop.map((l, i) => (
            <li class="loop-item">
              <span class="loop-index">{i + 1}</span>
              <div>
                <h3 class="loop-step">{l.step}</h3>
                <p class="card-body">{l.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-24) 0 var(--space-16);
    border-bottom: 1px solid var(--line);
    background: var(--panel-soft);
  }

  .hero-title {
    font-size: 44px;
    font-weight: 700;
    margin-top: var(--space-6);
    max-width: 640px;
  }

  .hero-desc {
    margin-top: var(--space-6);
    font-size: 18px;
    color: var(--muted);
    max-width: 620px;
  }

  .hero-status {
    margin-top: var(--space-8);
    font-size: 14px;
    color: var(--muted);
  }

  .lead {
    font-size: 17px;
    color: var(--muted);
    max-width: 720px;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .card-title {
    font-size: 16px;
    font-weight: 650;
    margin-bottom: var(--space-2);
  }

  .card-body {
    font-size: 14px;
    color: var(--muted);
  }

  .loop {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .loop-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .loop-index {
    flex: none;
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--purple-50);
    color: var(--purple);
    font-size: 13px;
    font-weight: 650;
  }

  .loop-step {
    font-size: 15px;
    font-weight: 650;
    margin-bottom: var(--space-1);
  }

  @media (max-width: 720px) {
    .hero-title {
      font-size: 32px;
    }

    .grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
